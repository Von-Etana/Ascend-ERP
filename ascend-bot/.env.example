# WhatsApp Cloud API (from Meta Developer dashboard > WhatsApp > API Setup)
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_string_you_want_here

# Optional: sales team number to forward hot leads to (E.164 format, no +)
SALES_TEAM_WHATSAPP_NUMBER=2348000000000

# Server
PORT=3000
