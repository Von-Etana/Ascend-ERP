APP_NAME="Ascend Systems"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_INSTALLED=false
APP_DEMO=false
APP_INTERNAL_WORKSPACE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ascend_systems
DB_USERNAME=ascend_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=ascend_systems_session
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# cPanel shared hosting: run `php artisan ascend:shared-queue` from Cron Jobs.
CPANEL_QUEUE_MAX_JOBS=25
CPANEL_QUEUE_MAX_TIME=50
CPANEL_QUEUE_TIMEOUT=45
CPANEL_QUEUE_SLEEP=1
CPANEL_QUEUE_TRIES=3

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INBOX_AI_ENABLED=true
INBOX_AI_CONFIDENCE_THRESHOLD=0.80
INBOX_WHATSAPP_WEBHOOK_SECRET=
INBOX_INSTAGRAM_WEBHOOK_SECRET=
INBOX_MESSENGER_WEBHOOK_SECRET=
INBOX_TELEGRAM_WEBHOOK_SECRET=
INBOX_LINKEDIN_WEBHOOK_SECRET=
INBOX_TIKTOK_WEBHOOK_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@your-domain.com
RESEND_FROM_NAME="Ascend Systems"
